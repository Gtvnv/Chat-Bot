# Copie este arquivo para .env e ajuste os valores. Nunca versione o .env.

# Provedores: "local" (Ollama, sem envio de dados a terceiros) ou "externo" (OpenAI)
PROVEDOR_EMBEDDINGS=local
PROVEDOR_GERACAO=local

# Chave de API: necessária apenas se algum provedor for "externo"
OPENAI_API_KEY=sua-chave-aqui

# Provedor local (Ollama)
OLLAMA_HOST=http://localhost:11434
MODELO_EMBEDDINGS_LOCAL=nomic-embed-text
MODELO_GERACAO_LOCAL=llama3.2

# Provedor externo (OpenAI)
MODELO_EMBEDDINGS_EXTERNO=text-embedding-3-small
MODELO_GERACAO_EXTERNO=gpt-4o-mini

# Parâmetros de chunking e recuperação
TAMANHO_TRECHO=1000
SOBREPOSICAO=200
TOP_K=4

# Geração: tempo limite em segundos (inteiro de 10 a 600) e temperatura (0 a 1;
# aceita ponto ou vírgula decimal). Em máquinas sem GPU, aumente o tempo limite.
TIMEOUT_GERACAO_S=60
TEMPERATURA_GERACAO=0.2

# Diretório onde o índice vetorial é gravado
DIRETORIO_INDICE=data/index
